	(text "R3/C6: fit R3 = 10k and C6 to turn PWM on LED_DRIVE into a DC setpoint."
		(exclude_from_sim no)
		(at 99.314 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "898f396e-3fd5-4348-b426-68d7383ac326")
	)
	(text "Backlight: on by default (the module pulls BLK up). P0.17 (BL_OFF) high turns it off; PWM it to dim."
		(exclude_from_sim no)
		(at 198.12 130.302 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "923b13ff-2eb3-42e1-b530-e9759dbfcc38")
	)
	(text "R1/R2: I2C pull-ups.  R11: ALERT/RDY is open-drain.  C11 at U3 VDD."
		(exclude_from_sim no)
		(at 162.56 270.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a5b6381f-e5e7-4218-a871-2e6b0f53fcf3")
	)
	(text "C15/C16: microSD supply decoupling,\nplace right at J10 pin 4 (VDD)."
		(exclude_from_sim no)
		(at 259.08 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bab34acb-43fa-4a8a-90ba-8ccca589111c")
	)
	(text "   the detector/emitter JST connectors and test points. Earlier draft: hardware/uv-control/reference/v0.4-draft/."
		(exclude_from_sim no)
		(at 162.56 240.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cd25a47a-fba4-4636-ad11-19ad33a3caf0")
	)
	(text "Buttons"
		(exclude_from_sim no)
		(at 127 18.796 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "d43d17ff-4f54-4ea9-9522-59ca038ffdc5")
	)
	(text "LED pulse option (555)"
