				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "def88abf-3218-41c0-8065-b7ec3281dabc")
	)
	(text "EMIT_LED_DISABLE: HIGH turns the emitter's LED off (it grounds the current setpoint)."
		(exclude_from_sim no)
		(at 162.56 251.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f4f2e4be-5d5d-4f1a-9363-0b6ec80fe1b8")
	)
	(text "   LOW or floating lets LED_DRIVE set the current (3.3 V -> ~26 mA)."
		(exclude_from_sim no)
		(at 162.56 255.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f8756ab5-151d-4e35-a05b-23daa5f19e98")
	)
	(text "   (the emitter port puts V_LED and 5V on detector outputs)."
