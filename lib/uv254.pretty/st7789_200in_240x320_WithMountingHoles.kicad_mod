(footprint "st7789_200in_240x320_WithMountingHoles"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "2.0 in 240x320 ST7789 IPS TFT module, Golden Morning GMT020-02-8P (sold as XIITIA), 37.25 x 62 mm, on a 1x8 2.54 mm header. Pins 1 BL, 2 CS, 3 DC, 4 RST, 5 SDA, 6 SCL, 7 VCC, 8 GND, the same order as st7789_154in_240x240 (the module marks GND with its square pad). Module outline, corner holes (about 2.5 mm) and active area on Dwgs.User; courtyard is the whole module. Header offset and holes measured from photos: check with calipers. With the module's four corner holes drilled 2.7 mm (M2.5 clearance) for 2.5 mm spacers, each with a 6 mm copper keep-out (tracks, vias, fill) on both sides. The hole positions are photo estimates (+/-0.3 mm): measure a module before ordering.")
	(tags "ST7789 TFT LCD 2.0in 240x320 GMT020 display module 1x08 2.54mm")
